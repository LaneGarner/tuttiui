{
  "name": "@tuttiui/shared",
  "version": "0.3.0",
  "description": "Shared utilities for the tuttiui design system",
  "license": "MIT",
  "author": "Lane Garner",
  "repository": {
    "type": "git",
    "url": "https://github.com/lanegarner/tuttiui.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/lanegarner/tuttiui#readme",
  "bugs": "https://github.com/lanegarner/tuttiui/issues",
  "keywords": [
    "react",
    "components",
    "design-system",
    "tailwindcss",
    "ui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.mjs",
      "require": "./dist/native.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tuttiui/tokens": "workspace:*",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.2.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.74.0",
    "nativewind": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "nativewind": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "~5.9.2"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false
}
