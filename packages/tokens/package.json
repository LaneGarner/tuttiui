{
  "name": "@tutti-ui/tokens",
  "version": "0.2.0",
  "description": "Design tokens for the tutti-ui design system",
  "license": "MIT",
  "author": "Lane Garner",
  "repository": {
    "type": "git",
    "url": "https://github.com/lanegarner/tutti-ui.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/lanegarner/tutti-ui#readme",
  "bugs": "https://github.com/lanegarner/tutti-ui/issues",
  "keywords": [
    "react",
    "components",
    "design-system",
    "tailwindcss",
    "ui",
    "design-tokens"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "~5.9.2"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false
}
