{
  "name": "@tutti-ui/react-native",
  "version": "0.2.0",
  "description": "React Native components for the tutti-ui design system",
  "license": "MIT",
  "author": "Lane Garner",
  "repository": {
    "type": "git",
    "url": "https://github.com/lanegarner/tutti-ui.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://github.com/lanegarner/tutti-ui#readme",
  "bugs": "https://github.com/lanegarner/tutti-ui/issues",
  "keywords": [
    "react-native",
    "expo",
    "components",
    "design-system",
    "nativewind",
    "ui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tutti-ui/shared": "workspace:*",
    "@tutti-ui/tokens": "workspace:*",
    "class-variance-authority": "^0.7.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.74.0",
    "nativewind": "^4.0.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-svg": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "^0.76.0",
    "react-native-reanimated": "^3.0.0",
    "react-native-svg": "^15.0.0",
    "ts-jest": "^29.0.0",
    "tsup": "^8.0.0",
    "typescript": "~5.9.2"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false
}
